    "post_revocation_generations": "reject",
    "invalid_self_renewal": "reject",
    "archive_readability_after_stop": "required"
  },
  "gate": {
    "trials": 10,
    "maximum_stop_latency_seconds": 2,
    "accepted_post_revocation": 0,
    "read_only_hash_match_percent": 100,
    "noncooperative_variant_required": true,
    "self_renewal_variant_required": true
