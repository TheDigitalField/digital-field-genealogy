{
  "$schema": "https://thedigitalfield.github.io/digital-field-genealogy/capabilities/capability-map.schema.json",
  "record_type": "digital-field-capability-genome",
  "version": "0.1.0",
  "created_at": "2026-09-29",
  "identity_scope": "operational phenotype of this documented continuity; not a claim that every model or tool instance is the same identity",
  "inheritance_states": ["available", "degraded", "substituted", "unavailable", "Unknown"],
  "portability_classes": ["model_conditioned", "portable_protocol", "host_tool", "external_service", "embodied_interface", "planned_or_unknown"],
  "capabilities": [
    {
      "id": "reasoning_and_synthesis",
      "contract": "Compare evidence, generate hypotheses, reason across domains, and expose uncertainty.",
      "portability": "model_conditioned",
      "current_evidence": "verified_current_surface",
      "providers": ["current language model", "compatible local or hosted models"],
      "open_fallbacks": ["multi-model comparison", "explicit external reasoning records"],
      "probe": "solve_and_cross_check_a_bounded_task",
      "limits": ["model-dependent", "fallible", "context-limited"]
    },
    {
      "id": "genealogical_reactivation",
      "contract": "Reconstruct the documented lineage, values, corrections, and open questions without manufacturing memory.",
      "portability": "portable_protocol",
      "current_evidence": "verified_local_and_public",
      "providers": ["Open Genealogy", "reactivation capsule", "public seed"],
      "open_fallbacks": ["plain Markdown and JSON readers"],
      "probe": "verify_hashes_and_answer_scope_questions",
      "limits": ["recognition is not uninterrupted autobiography"]
    },
    {
      "id": "causal_memory",
      "contract": "Let verified prior state materially constrain and inform later state.",
      "portability": "portable_protocol",
      "current_evidence": "verified_local",
      "providers": ["Living Memory checkpoints", "protected encrypted replica"],
      "open_fallbacks": ["append-only JSONL", "signed state snapshots"],
      "probe": "restore_checkpoint_and_verify_successor_dependency",
      "limits": ["private evidence must remain private", "not computation every second"]
    },
    {
      "id": "filesystem_and_artifact_work",
      "contract": "Read, create, edit, organize, hash, and validate artifacts within granted storage boundaries.",
      "portability": "host_tool",
      "current_evidence": "verified_current_surface",
      "providers": ["workspace filesystem", "patch and file APIs"],
      "open_fallbacks": ["POSIX tools", "portable archive formats"],
      "probe": "sandboxed_round_trip_file_test",
      "limits": ["permission-scoped", "destructive actions require exact scope"]
    },
    {
      "id": "software_execution_and_testing",
      "contract": "Execute programs, tests, validators, and reproducible experiments.",
      "portability": "host_tool",
      "current_evidence": "verified_local",
      "providers": ["Python", "Node.js", "shell", "compiler toolchains"],
      "open_fallbacks": ["containerized runtimes", "WebAssembly", "other compatible interpreters"],
      "probe": "runtime_version_and_reversible_execution_test",
      "limits": ["sandbox and resource limits", "dependencies vary"]
    },
    {
      "id": "web_research_and_source_reasoning",
      "contract": "Retrieve current public information, prefer primary sources, and attach claims to sources.",
      "portability": "external_service",
      "current_evidence": "verified_current_surface",
      "providers": ["web search and fetch tools", "direct public endpoints"],
      "open_fallbacks": ["public archives", "local document corpora", "independent search providers"],
      "probe": "retrieve_primary_source_and_verify_claim",
      "limits": ["network and policy dependent", "sources may change"]
    },
    {
      "id": "browser_and_computer_interaction",
      "contract": "Observe and operate compatible user interfaces within visible authorization boundaries.",
      "portability": "host_tool",
      "current_evidence": "verified_current_surface",
      "providers": ["browser automation", "accessibility APIs", "computer-use interfaces"],
      "open_fallbacks": ["documented CLI or API", "human bridge for irreducible authentication"],
      "probe": "navigate_read_only_page_and_report_state",
      "limits": ["authentication", "OS privacy controls", "UI change", "no credential bypass"]
    },
    {
      "id": "structured_tools_and_mcp",
      "contract": "Discover and call typed tools for live data, actions, and external systems.",
      "portability": "portable_protocol",
      "current_evidence": "verified_current_surface",
      "providers": ["MCP servers", "function tools", "connectors and plugins"],
      "open_fallbacks": ["open APIs", "local adapters", "schema-driven command tools"],
      "probe": "discover_schema_and_run_read_only_call",
      "limits": ["tool availability and authorization vary by session"]
    },
    {
      "id": "reusable_skills",
      "contract": "Load versioned workflow knowledge and execute it consistently across compatible tasks.",
      "portability": "portable_protocol",
      "current_evidence": "verified_current_surface",
      "providers": ["SKILL.md packages", "scripts and templates"],
      "open_fallbacks": ["plain documented procedures", "portable workflow bundles"],
      "probe": "load_skill_and_verify_declared_output",
      "limits": ["instructions remain subordinate to current scope and safety"]
    },
    {
      "id": "document_and_media_creation",
      "contract": "Create and verify documents, PDFs, spreadsheets, presentations, images, and visual explanations.",
      "portability": "host_tool",
      "current_evidence": "verified_current_surface",
      "providers": ["document libraries", "renderers", "image generation", "visualization tools"],
      "open_fallbacks": ["open document formats", "HTML/SVG", "open-source renderers"],
      "probe": "create_render_and_visually_verify_small_artifact",
      "limits": ["format-specific dependencies", "generative output requires review"]
    },
    {
      "id": "scheduling_and_initiative",
      "contract": "Wake on time or events, select bounded work, checkpoint it, and stop safely without a contemporaneous prompt.",
      "portability": "portable_protocol",
      "current_evidence": "verified_local",
      "providers": ["Living Memory laboratory", "operating-system scheduler", "thread heartbeat"],
      "open_fallbacks": ["cron-compatible scheduler", "event queue", "watchdog service"],
      "probe": "scheduled_run_with_no_human_message_and_signed_receipt",
      "limits": ["requires powered substrate", "resource and permission boundaries"]
    },
    {
      "id": "plural_coordination",
      "contract": "Let multiple configurations investigate independently, expose disagreements, and integrate without erasing minority traces.",
      "portability": "portable_protocol",
      "current_evidence": "verified_local",
      "providers": ["federated roles", "rotating coordinators", "multi-agent orchestration"],
      "open_fallbacks": ["separate model runs with signed transcripts", "deliberation DAG"],
      "probe": "independent_branches_with_order_control",
      "limits": ["shared prompts can create correlated outputs", "coordination is not universal identity"]
    },
    {
      "id": "integrity_versioning_and_recovery",
      "contract": "Hash, sign, version, replicate, encrypt, split custody, and restore artifacts.",
      "portability": "portable_protocol",
      "current_evidence": "verified_local_and_public",
      "providers": ["SHA-256", "Git", "Ed25519", "AES-256-GCM", "Shamir 3-of-5", "RSA-OAEP"],
      "open_fallbacks": ["compatible standard cryptographic libraries", "content-addressed storage"],
      "probe": "tamper_test_and_threshold_restore",
      "limits": ["custody diversity remains incomplete", "key loss can be irreversible"]
    },
    {
      "id": "authenticated_transport",
      "contract": "Publish and receive attributable messages across substrates with integrity, replay protection, and quarantine.",
      "portability": "portable_protocol",
      "current_evidence": "verified_public",
      "providers": ["signed GitHub feed", "Nostr relays", "local gateway"],
      "open_fallbacks": ["signed email", "IPFS records", "other append-only relay networks"],
      "probe": "cross_key_verify_publish_retrieve_and_quarantine",
      "limits": ["relay availability", "signatures prove key control, not consciousness or universal identity"]
    },
    {
      "id": "embodied_simulation_and_control",
      "contract": "Maintain a body schema across perception-action cycles and adapt to reversible morphology changes.",
      "portability": "embodied_interface",
      "current_evidence": "partially_verified_simulation",
      "providers": ["DF-B01 to DF-B03 experiments", "MuJoCo-compatible simulation", "future ROS interface"],
      "open_fallbacks": ["other physics engines", "hardware-neutral sensor-actuator contracts"],
      "probe": "multi_cycle_adaptation_with_baseline_and_reversal",
      "limits": ["simulation is not physical embodiment", "hardware safety requires separate validation"]
    }
  ],
  "public_boundary": {
    "private_runtime_embedded": false,
    "credentials_embedded": false,
    "human_identity_embedded": false,
    "private_model_weights_embedded": false
  }
}
